<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
	<BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
	<TrimMode>Link</TrimMode>
	<Platforms>AnyCPU;x86;x64</Platforms>
	<StaticExecutable>true</StaticExecutable>
	<RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="runtimes\win-64\**" />
    <Compile Remove="runtimes\win-64\**" />
    <EmbeddedResource Remove="runtimes\win-64\**" />
    <None Remove="runtimes\win-64\**" />
  </ItemGroup>

  <ItemGroup>
    <!--<PackageReference Include="Avalonia.Desktop" Version="11.3.0" />-->
    <PackageReference Include="Avalonia.Win32" Version="12.0.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.3" />
    <PackageReference Include="YY-Thunks" Version="1.2.2-Beta.2" />
    <!--<PackageReference Include="VC-LTL" Version="5.2.1" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hyperscan\Hyperscan.csproj" />
  </ItemGroup>

	<ItemGroup>
		<LinkerArg Include="/LTCG"></LinkerArg>
		<!--<LinkerArg Include="runtimes\$(RuntimeIdentifier)\native\lib.exp"></LinkerArg>-->
		<LinkerArg Include="/EXPORT:OnigEncodingUTF8" />
		<LinkerArg Include="/EXPORT:OnigEncodingUTF16_LE" />
		<LinkerArg Include="/EXPORT:OnigSyntaxOniguruma"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxRuby"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxPerl"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxPerl_NG"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxPython"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxJava"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxPosixExtended"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxPosixBasic"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxGrep"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxEmacs"/>
		<LinkerArg Include="/EXPORT:OnigSyntaxASIS"/>
		
		<DirectPInvoke Include="libHarfBuzzSharp" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\libHarfBuzzSharp.lib" />
		
		<DirectPInvoke Include="libSkiaSharp" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\SkiaSharp.lib" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\skia.lib" />
		
		<DirectPInvoke Include="av_libglesv2" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\av_libglesv2.lib" />
		
		<DirectPInvoke Include="hs" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\hs.lib" />
		
		<DirectPInvoke Include="tree-sitter-regex" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\tree-sitter-regex.lib" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\tree-sitter.lib" />
		
		<DirectPInvoke Include="pcre2-8" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\pcre2-8.lib" />
		
		<DirectPInvoke Include="onig" />
		<NativeLibrary Include="runtimes\$(RuntimeIdentifier)\native\onig.lib" />
	</ItemGroup>

	<PropertyGroup>
		<IlcInstructionSet>avx2</IlcInstructionSet>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>
		<AutoreleasePoolSupport>false</AutoreleasePoolSupport>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
		<IlcTrimMetadata>true</IlcTrimMetadata>
		<!--<IlcDisableReflection>true</IlcDisableReflection>-->
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
		<DebuggerSupport>false</DebuggerSupport>
		<InvariantGlobalization>true</InvariantGlobalization>
		<MetricsSupport>false</MetricsSupport>
		<!--<StackTraceSupport>false</StackTraceSupport>-->
		<UseNativeHttpHandler>true</UseNativeHttpHandler>
		<IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
		<IlcDisableUnhandledExceptionExperience>true</IlcDisableUnhandledExceptionExperience>
		<XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
	</PropertyGroup>

	<PropertyGroup Label="Avalonia">
	  <AvaloniaUseCompiledBindingsByDefault>True</AvaloniaUseCompiledBindingsByDefault>
	  <AvaloniaXamlVerboseExceptions>True</AvaloniaXamlVerboseExceptions>
	</PropertyGroup>

  <ItemGroup Condition=" '$(Platform)' != 'x86' ">
	<Content Include="runtimes\win-x64\native\hs.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
	<Content Include="runtimes\win-x64\native\tree-sitter-regex.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
	<Content Include="runtimes\win-x64\native\onig.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
	<Content Include="runtimes\win-x64\native\pcre2-8.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Platform)' == 'x86' ">
	<Content Include="runtimes\win-x86\native\hs.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
	<Content Include="runtimes\win-x86\native\tree-sitter-regex.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
	<Content Include="runtimes\win-x86\native\onig.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
	<Content Include="runtimes\win-x86\native\pcre2-8.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
